    {
      "wordId": "l16-17", "partOfSpeech": ["verb"],
      "memoryAid": {"kind":"word-family","noteZh":"plagiarise 是动词；plagiarism 是“剽窃、抄袭”这一行为的名词。"},
      "relations": [{"label":"cite","type":"semantic","targetWordId":"l16-32","isExtension":false},{"label":"quote","type":"semantic","targetWordId":"l16-34","isExtension":false},{"label":"reference","type":"semantic","targetWordId":"l16-31","isExtension":false},{"label":"plagiarism","type":"word-family","isExtension":true}],
