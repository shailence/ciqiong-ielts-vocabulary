    {
      "wordId": "l1-39", "partOfSpeech": ["noun"],
      "memoryAid": {"kind":"word-family","noteZh":"把 volcano 与同主题的 magma、erupt 连成“岩浆—喷发—火山”过程链；不对单词做牵强拆分。"},
      "relations": [{"label":"magma","type":"semantic","targetWordId":"l1-41","isExtension":false},{"label":"erupt","type":"semantic","targetWordId":"l1-40","isExtension":false},{"label":"earthquake","type":"same-theme","targetWordId":"l1-50","isExtension":false},{"label":"eruption","type":"word-family","isExtension":true,"noteZh":"erupt 的名词"}],
