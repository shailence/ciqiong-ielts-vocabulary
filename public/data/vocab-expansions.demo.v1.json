      "memoryAid": {"kind":"compound","noteZh":"earth + quake：地面发生震动；quake 本身表示“震动”。"},
      "relations": [{"label":"seismic","type":"same-theme","targetWordId":"l1-51","isExtension":false},{"label":"plate","type":"semantic","targetWordId":"l4-1","isExtension":false},{"label":"magnitude","type":"semantic","isExtension":true},{"label":"aftershock","type":"semantic","isExtension":true}],
